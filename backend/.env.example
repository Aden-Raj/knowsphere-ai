APP_NAME="KnowSphere AI API"
ENVIRONMENT=development
API_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://knowsphere:change-this-local-password@localhost:5432/knowsphere
CORS_ORIGINS=["http://localhost:4200"]
UPLOAD_DIR=data/uploads
CHROMA_PERSIST_DIR=data/chroma
CHROMA_COLLECTION_NAME=knowsphere_documents
MAX_UPLOAD_SIZE_BYTES=26214400
MAX_UPLOAD_FILES=20
MAX_UNCOMPRESSED_BYTES=104857600
MAX_EXTRACTED_CHARS=5000000
MAX_DOCUMENT_PAGES=2000
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
HUGGINGFACE_CACHE_DIR=data/huggingface/hub
RAG_TOP_K=5
RAG_MIN_RELEVANCE=0.20
RAG_CONTEXT_TOKEN_BUDGET=4000
RAG_EXECUTION_MODE=legacy
CONVERSATION_HISTORY_MAX_MESSAGES=10
CONVERSATION_HISTORY_MAX_CHARS=8000
LLM_PROVIDER=none
LLM_MODEL=
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
LLM_TIMEOUT_SECONDS=180
LLM_MAX_TOKENS=800
